#Copy to .env on each node and edit. .env is gitignored — it is the only file
#in the repo that differs between node1 and node2.

#node1 or node2. Reported by /health, brp_app_info, and every log line.
#Getting this wrong misattributes everything downstream, so docker-compose
#refuses to start without it rather than defaulting to "unknown".
NODE_NAME=node1

#image tag. Bump this to roll out a new version; /health echoes it back so you
#can confirm the node actually took the new image.
APP_VERSION=dev

#Both nodes run their own Prometheus, so /slo always queries THIS node's
#instance and never reaches the peer. Leave as-is on both nodes — the value is
#identical, which is the whole point of using a name rather than an address.
#
#NOT 127.0.0.1. The app runs in a container; Prometheus runs on the host. From
#inside the container 127.0.0.1 is the container's own loopback, where nothing
#is listening, and /slo reports status: unavailable — correctly, since the app
#genuinely cannot reach it. host.docker.internal resolves to the host under
#both runtimes: Podman aliases it natively, and docker-compose.yml maps it via
#extra_hosts: host-gateway.
#
#On node1 this also needs a ufw rule — the container's source address is on the
#Docker bridge, not the LAN, so §1a's 9090 rule does not cover it. RUNBOOK.md
#§1d has it. node2 needs nothing: pasta routes to the host without touching
#firewalld.
PROM_URL=http://host.docker.internal:9090

#journald on the real nodes, json-file on a dev box without systemd
LOG_DRIVER=journald
