# Quadlet unit for node2 (Rocky, Podman). Rootless.
#
# Install to:  ~/.config/containers/systemd/brp-api.container
# Then:        systemctl --user daemon-reload && systemctl --user start brp-api
#
# Quadlet is Podman's systemd-native deployment. It generates a real
# brp-api.service from this file at daemon-reload, so the container is managed
# by systemd like any other service. This is the piece that makes the container
# survive a reboot: Podman is daemonless, so `podman run --restart` alone has
# nothing watching to restart it after boot. systemd is that watcher.
#
# Rootless (runs as the ericratz user, not root) because that is Podman's whole
# security proposition on RHEL, and the app only needs port 8000 (>1024), which
# rootless can bind without privilege. Port 80 belongs to host nginx, not this
# container, so nothing here needs root.
#
# REQUIRES lingering, or the unit stops when you log out:
#   sudo loginctl enable-linger ericratz
# Without it, systemctl --user services only run while a login session for the
# user exists — fine interactively, gone the moment SSH closes.

[Unit]
Description=BRP FastAPI reliability service
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/brp-api:latest
ContainerName=brp-api

# Rootless Podman forwards with pasta, which binds the WILDCARD and so accepts
# on ::1 as well — but the container's uvicorn listens on 0.0.0.0 only, so a v6
# connection completes its handshake and is then reset with nothing behind it.
# `localhost` resolves ::1 first on Rocky, and because the TCP connect SUCCEEDS
# the client does not fall back to 127.0.0.1: curl reports "Recv failure:
# Connection reset by peer", or with -s just an empty body — which reads as a
# dead app while it serves 200s on the v4 literal and on the LAN address.
#
# node1 does not have this problem with the same image: Docker's userland proxy
# publishes on both families and bridges v6 to the container's v4 socket. Same
# artifact, different behaviour — see CHANGELOG.
#
# The bind address is deliberately NOT set here. `PublishPort=0.0.0.0:8000:8000`
# was tried and is INERT under pasta: it lands in the unit, and podman then
# hands pasta a bare `-t 8000-8000:8000-8000` with the address dropped, so the
# wildcard bind and the reset both survive. Verified on node2 by reading the
# pasta command line out of `pgrep -a pasta` — the setting cannot be confirmed
# from this file or from `podman ps`, both of which report 0.0.0.0 either way.
PublishPort=8000:8000

# This is what actually pins the family: --ipv4-only is passed straight through
# to pasta, so nothing listens on ::1 and a v6 client gets a clean REFUSAL,
# which it does fall back from. Nothing in the platform needs v6 ingress — the
# nginx upstream, the Prometheus targets, PROM_URL and the health monitor's
# endpoints are all v4 literals — so this costs nothing.
#
# Confirm it took effect on the pasta process, never on this file:
#     pgrep -a pasta                    # expect --ipv4-only in the args
#     ss -ltn | grep 8000               # expect 0.0.0.0:8000, not *:8000
#
# The alternative fix is to make uvicorn dual-stack (`--host ::` in the
# Dockerfile CMD), which addresses the cause rather than the exposure. Rejected
# for now: it changes the shared artifact to fix a node2-only forwarding quirk,
# so it would need node1 rebuilt and re-verified, and it makes the container's
# v4 reachability depend on net.ipv6.bindv6only staying 0.
Network=pasta:--ipv4-only

# The one file that differs between nodes. Same NODE_NAME/APP_VERSION/PROM_URL
# contract as node1's compose, from the same .env, so both nodes are configured
# identically in shape.
#
# CAUTION: this makes .env authoritative for APP_VERSION on this node, which is
# NOT true on node1. The build-arg bakes ENV APP_VERSION into the image, and
# this file then overrides it at runtime — the app reads the runtime value
# (app/core/settings.py). Build with one version and leave .env at another and
# /health reports .env's, silently. Compose has no such split: it feeds one
# value to the build-arg, the image tag and the runtime env. Keep the build-arg
# and .env equal on this node; the rolling update in RUNBOOK.md §2 bumps both.
EnvironmentFile=%h/bare-metal-reliability-platform/.env

# journald so the health monitor's `journalctl` checks can read app logs next
# to OS logs. Podman's default is journald anyway; stated for parity with the
# compose file and so it is not silently changed by a config default.
LogDriver=journald

[Service]
# Restart policy lives here (systemd), not in the container — the daemonless
# point again. always: bring it back on crash and on boot.
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
